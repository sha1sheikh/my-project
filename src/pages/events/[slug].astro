---
import Layout from '../../layouts/Layout.astro';
import SourceRefs from '../../components/SourceRefs.astro';
import { getCollection } from 'astro:content';
import { getSourceMap, getAllOrganisations } from '../../lib/data';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((e) => ({ params: { slug: e.data.slug }, props: { event: e.data } }));
}

const { event } = Astro.props;
const sourceMap = await getSourceMap();
const allOrgs = await getAllOrganisations();
const orgName = (s: string) => allOrgs.find((o) => o.data.slug === s)?.data.legal_name ?? s;

const allActivities = await getCollection('activities');
const activities = allActivities
  .filter((a) => event.activity_ids.includes(a.data.id))
  .filter((a) => a.data.source_ids.every((id) => sourceMap.has(id)))
  .sort((a, b) => (a.data.date < b.data.date ? 1 : -1));
---

<Layout title={event.name} description={event.summary}>
  <h1 class="text-2xl font-semibold tracking-tight">{event.name}</h1>
  {event.date && <p class="text-sm text-neutral-500">{event.date}</p>}
  {event.summary && <p class="mt-2 max-w-2xl text-neutral-800 dark:text-neutral-200">{event.summary}</p>}

  <section class="mt-6">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-neutral-500">Related activity</h2>
    <ol class="mt-3 space-y-3">
      {activities.map((a) => (
        <li class="border-l-2 border-neutral-300 pl-3 dark:border-neutral-700">
          <div class="text-xs text-neutral-500">
            {a.data.date} · <a href={`/organisations/${a.data.org_slug}`}>{orgName(a.data.org_slug)}</a> · {a.data.activity_type.replace('_', ' ')}
          </div>
          <p>
            {a.data.description}
            <SourceRefs sourceIds={a.data.source_ids} sourceMap={sourceMap} />
          </p>
        </li>
      ))}
    </ol>
  </section>
</Layout>
