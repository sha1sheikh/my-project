---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getAllOrganisations } from '../lib/data';

const corrections = (await getCollection('corrections')).sort((a, b) => (a.data.date < b.data.date ? 1 : -1));
const allOrgs = await getAllOrganisations();
const orgName = (s?: string) => (s ? allOrgs.find((o) => o.data.slug === s)?.data.legal_name ?? s : undefined);
---

<Layout title="Corrections">
  <h1 class="text-2xl font-semibold tracking-tight">Corrections log</h1>
  <p class="mt-2 max-w-2xl text-neutral-800 dark:text-neutral-200">
    Every correction, removal or added reply to a record on this register is logged here with
    the date it was made.
  </p>

  <section class="mt-6 border border-neutral-200 p-4 text-sm dark:border-neutral-800">
    <h2 class="font-semibold">Requesting a correction or reply</h2>
    <p class="mt-1">
      An organisation covered by this register can request a correction to any record, or submit
      a reply for publication alongside the records it responds to. Send the record in question,
      the correction or reply text, and any supporting document, to
      <strong> corrections@example.org</strong>. Requests are reviewed and, where a change is
      made, logged below with the date.
    </p>
  </section>

  {corrections.length === 0 ? (
    <p class="mt-6 text-sm text-neutral-500">No corrections have been logged.</p>
  ) : (
    <ol class="mt-6 space-y-3">
      {corrections.map((c) => (
        <li class="border-l-2 border-neutral-300 pl-3 dark:border-neutral-700">
          <div class="text-xs text-neutral-500">
            {c.data.date} · {c.data.action.replace('_', ' ')}
            {c.data.org_slug && (
              <>
                {' · '}<a href={`/organisations/${c.data.org_slug}`}>{orgName(c.data.org_slug)}</a>
              </>
            )}
          </div>
          <p>{c.data.description}</p>
          {c.data.source_url && <a href={c.data.source_url} target="_blank" rel="noopener noreferrer" class="text-xs">reference</a>}
        </li>
      ))}
    </ol>
  )}
</Layout>
