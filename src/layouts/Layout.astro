---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'A source-first public register of advocacy and lobbying organisations.',
} = Astro.props;

const nav = [
  { href: '/organisations', label: 'Organisations' },
  { href: '/sectors/higher_education', label: 'Sectors' },
  { href: '/sources', label: 'Sources' },
  { href: '/recent', label: 'Recent' },
  { href: '/methodology', label: 'Methodology' },
  { href: '/submit', label: 'Submit' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Register of Advocacy &amp; Lobbying Organisations</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b border-neutral-300 dark:border-neutral-700">
      <div class="mx-auto max-w-4xl px-4 py-4">
        <a href="/" class="block text-lg font-semibold tracking-tight no-underline">
          Register of Advocacy &amp; Lobbying Organisations
        </a>
        <p class="text-xs text-neutral-500 dark:text-neutral-400">
          UK higher education — expanding to other sectors
        </p>
        <nav class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
          {nav.map((item) => (
            <a href={item.href} class="no-underline hover:underline">{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main class="mx-auto w-full max-w-4xl flex-1 px-4 py-8">
      <slot />
    </main>
    <footer class="border-t border-neutral-300 px-4 py-6 text-xs text-neutral-500 dark:border-neutral-700 dark:text-neutral-400">
      <div class="mx-auto max-w-4xl space-y-1">
        <p>Every activity, funding and affiliation record on this site is drawn from a cited public document. See <a href="/methodology">methodology</a> for sourcing standards.</p>
        <p>This register covers organisations only. It contains no data about named individuals.</p>
      </div>
    </footer>
  </body>
</html>
